{
  "manifest_version": 2,
  "name": "Zotero Rule Outline",
  "version": "1.0.2",
  "description": "本地规则生成中文 PDF 大纲，支持预览编辑、临时备份、原附件写入及批注和同步关系保留。",
  "author": "Rule Outline Contributors",
  "applications": {
    "zotero": {
      "id": "rule-outline@local.zotero",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*",
      "update_url": "https://raw.githubusercontent.com/p1aintiff/zotero-rule-outline/main/updates.json"
    }
  }
}
